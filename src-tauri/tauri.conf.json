{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HommOE Scenario Editor",
  "version": "0.9.1",
  "identifier": "com.oe.map-editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HommOE Scenario Editor",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MEFFNUVFN0I1NzNFREUKUldUZVBsZDc3dVVLcHFraWFBV05kRHBhNndVbUk1MzFZRVJkS2FVK0tqTlo2NmRsTTNybkdpMU8K",
      "endpoints": [
        "https://github.com/mimiasei/map-editor-json-tool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "cli": {
      "description": "HommOE Scenario Editor — headless random map generation for the GME mod",
      "args": [
        {
          "name": "generate",
          "description": "Generate a random map headlessly, write it to --output, then exit",
          "takesValue": false,
          "short": "g"
        },
        {
          "name": "output",
          "description": "Absolute path of the .map file to write",
          "takesValue": true
        },
        {
          "name": "result",
          "description": "Absolute path of a JSON file describing the outcome",
          "takesValue": true
        },
        {
          "name": "size",
          "description": "Optional. Square map size: N or NxN (only the first number is read), e.g. 64 or 64x64. One of 16, 32, 48, 64, 80, 96, 128, 256. Default 64",
          "takesValue": true
        },
        {
          "name": "players",
          "description": "Number of players",
          "takesValue": true
        },
        {
          "name": "seed",
          "description": "Numeric seed for a reproducible map",
          "takesValue": true
        },
        {
          "name": "name",
          "description": "Map name",
          "takesValue": true
        },
        {
          "name": "richness",
          "description": "Optional. Classic richness, 0-4 index: 0=poor 1=modest 2=medium (default) 3=rich 4=very_rich",
          "takesValue": true
        },
        {
          "name": "complexity",
          "description": "Optional. Classic complexity, 0-4 index: 0=sparse 1=light 2=medium (default) 3=dense 4=very_dense",
          "takesValue": true
        },
        {
          "name": "water",
          "description": "Optional. Classic water, 0-4 index: 0=none 1=few lakes 2=some lakes (default) 3=many lakes 4=islands",
          "takesValue": true
        },
        {
          "name": "template",
          "description": "Accepted for forward compatibility; ignored (Classic mode only)",
          "takesValue": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "externalBin": [
      "sidecar/extract_thumbnails"
    ],
    "resources": [
      "resources/template.map",
      "resources/templates/*"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
